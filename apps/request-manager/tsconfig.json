{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@workops-suite/shared-auth": [
        "../../packages/shared-auth/src/index.ts"
      ],
      "@workops-suite/shared-navigation": [
        "../../packages/shared-navigation/src/index.ts"
      ],
      "@workops-suite/shared-notification": [
        "../../packages/shared-notification/src/index.ts"
      ],
      "@workops/data-schema": [
        "../../packages/shared-backend/amplify/data/resource"
      ]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
